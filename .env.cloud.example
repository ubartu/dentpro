# Public DNS A/AAAA records must point to this server before starting Caddy.
DENTPRO_WEB_DOMAIN=staff.example.com
DENTPRO_API_DOMAIN=api.example.com
# Optional compose.mail.yaml: verified transactional sender, no secrets here.
# DENTPRO_MAIL_FROM=no-reply@your-verified-domain.example
# Optional mail overlay fixes the trusted edge IP; change both if the subnet conflicts.
# DENTPRO_PRIVATE_SUBNET=172.28.40.0/24
# DENTPRO_PROXY_IP=172.28.40.10
