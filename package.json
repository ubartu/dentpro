{
  "name": "dentpro",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/site",
    "apps/mobile",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "site:dev": "npm run dev --workspace @dentpro/site",
    "site:build": "npm run build --workspace @dentpro/site",
    "site:typecheck": "npm run typecheck --workspace @dentpro/site",
    "site:security-check": "npm run security-check --workspace @dentpro/site",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test:e2e": "node tests/e2e/panels.cjs",
    "test:e2e:recovery": "node tests/e2e/password-recovery.cjs",
    "test:maps-embed": "node tests/maps-embed.cjs",
    "mobile": "npm run start --workspace @dentpro/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @dentpro/mobile",
    "mobile:export": "npm run export --workspace @dentpro/mobile",
    "mobile:test": "npm run test --workspace @dentpro/mobile",
    "mobile:lint": "npm run lint --workspace @dentpro/mobile",
    "contracts:mobile": "npm run generate --workspace @dentpro/contracts",
    "build:vinext": "cd apps/site && npm run build:vinext",
    "deploy:vinext": "cd apps/site && npm run deploy:vinext --"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.70.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
