FROM python:3.13-slim

ENV APP_ENV=cloud PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/services/api
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY services/api/requirements.lock.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY services/api/dentpro /app/services/api/dentpro
RUN useradd --uid 10001 --create-home dentpro && chown -R dentpro:dentpro /app
USER 10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "dentpro.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
