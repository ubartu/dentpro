# Physical devices: replace with your computer's LAN address, then start the API
# with DENTPRO_API_HOST=0.0.0.0. Android emulator defaults to 10.0.2.2:8000.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Release builds require HTTPS and a production-ready backend.
# Website hosting /clinic-map; must be HTTPS for release builds.
# EXPO_PUBLIC_MAPS_WEB_URL=https://your-dentpro-web-domain.example
