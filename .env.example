# Local development; use the separate .env.cloud.example for cloud staging.
APP_ENV=development
DATABASE_URL=sqlite:///.data/dentpro.db
# For a local PostgreSQL instance, set:
# DATABASE_URL=postgresql+psycopg://dentpro:dentpro@127.0.0.1:5432/dentpro
# Next.js env is read from apps/web/.env.local, or inherited by the process.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional server-side proposal-summary gateway. Keep API keys out of public app variables.
DENTPRO_AI_PROVIDER=template
DENTPRO_AI_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=add-only-in-your-local-secret-store

# Optional server-only Google Places (New). Off until a billed/restricted key is configured.
DENTPRO_GOOGLE_PLACES_ENABLED=false
# GOOGLE_PLACES_API_KEY=server-key-only
# GOOGLE_PLACES_API_KEY_FILE=/run/secrets/google_places_key

# Browser-visible Maps Embed key; restrict to Maps Embed API and your web domain.
# Next.js reads this from apps/web/.env.local or its inherited environment.
# GOOGLE_MAPS_EMBED_KEY=restricted-embed-key
# GOOGLE_MAPS_EMBED_KEY_FILE=/run/secrets/maps_embed_key

# Transactional password recovery; disabled until configured. API and worker only.
DENTPRO_MAIL_PROVIDER=disabled
# Use file only in development (writes private .data/mailbox/*.eml); resend for real delivery.
# DENTPRO_MAIL_FROM=no-reply@your-verified-domain.example
# DENTPRO_RESET_URL=https://your-web-domain.example/reset-password
# DENTPRO_RESET_SECRET_FILE=/run/secrets/reset_secret
# RESEND_API_KEY_FILE=/run/secrets/resend_key
# DENTPRO_MAILBOX_DIR=.data/mailbox
