# Local demo only; the API intentionally rejects any other APP_ENV.
APP_ENV=development
DATABASE_URL=sqlite:///.data/dentpro.db
# For a local PostgreSQL instance, set:
# DATABASE_URL=postgresql+psycopg://dentpro:dentpro@127.0.0.1:5432/dentpro
# Next.js env is read from apps/web/.env.local, or inherited by the process.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional server-side proposal-summary gateway. Keep API keys out of public app variables.
DENTPRO_AI_PROVIDER=template
DENTPRO_AI_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=add-only-in-your-local-secret-store
